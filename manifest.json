{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.0.0",
  "description": "__MSG_extDesc__",
  "default_locale": "zh_CN",

  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },

  "permissions": [
    "scripting",
    "tabs",
    "contextMenus",
    "notifications"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    },
    "default_title": "__MSG_extName__"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content/style.css"],
      "js": ["content/content.js"],
      "all_frames": true
    }
  ],

  "devtools_page": "devtools.html"
}
